{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "graft": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@nanonets/graft",
        "mcp"
      ],
      "enabled": true
    }
  },
  "provider": {
    "openai": {
      "options": {
        "baseURL": "{env:OPENAI_BASE_URL}"
      },
      "models": {
        "step-5-preview": {
          "name": "step-5-preview"
        }
      }
    }
  }
}
