{
  "name": "clawd-desktop",
  "private": true,
  "version": "0.87.0",
  "description": "Clawd Desktop — Electron 桌面壳（窗口/托盘/spawn Host/自动更新），壳内不造 IPC，Web UI 由 Python Host 托管",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "dist": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "cn.clawd.desktop",
    "productName": "Clawd Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "web/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "host/",
        "to": "host/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clawd Desktop"
    },
    "portable": {
      "artifactName": "ClawdDesktop-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.clawd.cn/desktop/",
        "channel": "latest"
      }
    ]
  }
}
